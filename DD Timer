--[[
  Map Switch Countdown — single-file Assetto Corsa CSP Lua app
  All settings are in this file. No separate config.lua required.

  IMPORTANT:
  - The default timer is a local fallback countdown.
  - For a true server-synchronized timer, configure TIMER_MODE = "http"
    and provide an endpoint returning JSON such as:
      {"seconds_remaining": 754}
    or:
      {"switch_at_unix": 1792530000}
  - Your hosting panel/server rotation system must expose that endpoint.
  - CSP's Lua HTTP API differs between versions; see the HTTP adapter note
    in fetchServerTimer() and adapt that function to your installed CSP API.
]]

-- =========================
-- CONFIG — edit these values
-- =========================
local SERVER_NAME = "MY ASSETTO SERVER"

-- "local" = countdown starts when this app loads (fallback/demo)
-- "http"   = attempt to read remaining time from your server endpoint
local TIMER_MODE = "local"

-- Used by local mode only, in minutes
local LOCAL_COUNTDOWN_MINUTES = 30

-- Used by HTTP mode. Endpoint should return JSON:
-- {"seconds_remaining": 754}
-- OR {"switch_at_unix": 1792530000}
local TIMER_ENDPOINT = "http://127.0.0.1:8080/map-switch-timer"

-- Overlay spacing from screen edges, in pixels
local TOP_PADDING = 28
local RIGHT_PADDING = 28

-- Overlay appearance
local PANEL_WIDTH = 300
local PANEL_HEIGHT = 100
local PANEL_PADDING = 12
local CORNER_ROUNDING = 8
local BACKGROUND = rgbm(0.07, 0.09, 0.12, 0.92)
local SERVER_COLOR = rgbm(0.70, 0.82, 0.94, 1.00)
local LABEL_COLOR = rgbm(0.84, 0.89, 0.95, 1.00)
local TIMER_COLOR = rgbm(1.00, 1.00, 1.00, 1.00)

-- How often to poll the HTTP endpoint (seconds)
local HTTP_POLL_SECONDS = 5

-- =========================
-- INTERNAL STATE
-- =========================
local secondsRemaining = math.max(0, LOCAL_COUNTDOWN_MINUTES * 60)
local lastClock = os.clock()
local lastPoll = -100000
local httpStatus = "Local timer"
local panelPos = nil

local function formatTime(seconds)
  seconds = math.max(0, math.floor(tonumber(seconds) or 0))
  local hours = math.floor(seconds / 3600)
  local minutes = math.floor((seconds % 3600) / 60)
  local secs = seconds % 60

  if hours > 0 then
    return string.format("%02d:%02d:%02d", hours, minutes, secs)
  end
  return string.format("%02d:%02d", minutes, secs)
end

local function readJsonTimer(body)
  if type(body) ~= "string" then return nil end

  local remaining = body:match('"seconds_remaining"%s*:%s*(%d+)')
  if remaining then return tonumber(remaining) end

  local switchAt = body:match('"switch_at_unix"%s*:%s*(%d+)')
  if switchAt then
    return math.max(0, tonumber(switchAt) - os.time())
  end

  return nil
end

local function fetchServerTimer()
  -- HTTP ADAPTER:
  -- Implement this function using the HTTP request API available in your
  -- installed Custom Shaders Patch version, or use a local bridge that writes
  -- a status file and read that file here if your CSP build supports it.
  --
  -- Intentionally does not guess an API name or silently claim synchronization.
  -- Until the adapter is implemented, HTTP mode displays "Waiting for server
  -- timer" and does not pretend the local fallback is authoritative.
  --
  -- Expected when connected:
  --   local body = <HTTP response body>
  --   local value = readJsonTimer(body)
  --   if value then
  --     secondsRemaining = value
  --     httpStatus = "Server synced"
  --     return
  --   end

  httpStatus = "HTTP adapter needed"
end

local function updateTimer()
  local now = os.clock()
  local dt = math.max(0, now - lastClock)
  lastClock = now

  if TIMER_MODE == "http" then
    if now - lastPoll >= HTTP_POLL_SECONDS then
      lastPoll = now
      fetchServerTimer()
    end
  else
    -- Fallback local countdown; it is not the server's authoritative timer.
    secondsRemaining = math.max(0, secondsRemaining - dt)
    httpStatus = "Local timer"
  end
end

function script.update(dt)
  updateTimer()
end
